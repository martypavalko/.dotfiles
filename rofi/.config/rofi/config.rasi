configuration{
    modi: ["drun", "window", "run"];
    icon-theme: "Papirus-Dark";
    show-icons: true;
    terminal: "foot";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    sidebar-mode: false;
    display-combi: "";
    display-drun: " ";
    display-run: " ";
    display-window: " ";

    kb-row-up: "Up,Control+p";
    kb-row-down: "Down,Control+n";
}
@theme ".config/rofi/tokyonight.rasi"
