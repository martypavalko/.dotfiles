[category="agent.complete"]
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/complete.oga

text-color=#a9b1d6
background-color=#1a1b26
border-color=#7aa2f7
border-size=2
border-radius=6
font=JetBrains Mono 10
width=350
height=100
margin=10
padding=15
default-timeout=5000

[urgency=low]
background-color=#1a1b26
border-color=#565f89
text-color=#a9b1d6

[urgency=high]
background-color=#1a1b26
border-color=#f7768e
text-color=#f7768e
default-timeout=0

